#!/bin/bash
#
# Screenshot one or more tabs of a window, for before/after comparison when
# moving a tab's layout into a .fl file.
#
#   scripts/fluid-probe after 2 3          # -> $TMPDIR/.../after_2.png, after_3.png
#   scripts/fluid-probe -w quick before 0
#   FLUID_PROBE_OUT=/tmp/shots scripts/fluid-probe before 2 3
#
# Typical use: run it once with the migration applied, once with it stashed,
# then hand both to fluid-compare. Tabs are selected from $ONYX_TAB rather than
# by name so a single build covers every tab.
#
# Onyx.GUI is patched temporarily (see fluid_patch.py) to open the window at
# startup and select the requested tab, then restored on exit, including on
# failure.

set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd -P)
ROOT=$HERE/../haskell
GUI=$ROOT/packages/onyx-exe-toolkit/src/Onyx/GUI.hs

WINDOW=misc
while getopts "w:" opt; do
  case $opt in
    w) WINDOW=$OPTARG ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -lt 2 ]; then
  echo "usage: $(basename "$0") [-w misc|quick] <name-prefix> <tab-index>..." >&2
  exit 2
fi
PREFIX=$1; shift

OUT=${FLUID_PROBE_OUT:-$(mktemp -d)}
mkdir -p "$OUT"

BAK=$(mktemp)
cp "$GUI" "$BAK"
trap 'cp "$BAK" "$GUI"; rm -f "$BAK"' EXIT

python3 "$HERE/fluid_patch.py" probe "$WINDOW" "$GUI"

# shellcheck source=fluid-build.sh
. "$HERE/fluid-build.sh"
fluid_build
cd "$ROOT"

for tab in "$@"; do
  ( ONYX_TAB=$tab timeout 22 ./stack-local exec onyx >"$OUT/${PREFIX}_$tab.log" 2>&1 ) &
  sleep 11
  # If onyx died on startup we would otherwise screenshot the bare desktop and
  # cheerfully report success.
  if ! kill -0 %1 2>/dev/null; then
    echo "onyx exited before it could be photographed:" >&2
    cat "$OUT/${PREFIX}_$tab.log" >&2
    exit 1
  fi
  import -window root "$OUT/${PREFIX}_$tab.png"
  sleep 1
  kill %1 2>/dev/null || true
  echo "$OUT/${PREFIX}_$tab.png"
  sleep 1
done
