#!/bin/bash
#
# Compare two fluid-probe screenshots and report how many pixels differ.
#
#   scripts/fluid-compare before_5.png after_5.png
#
# The two runs are separate processes, so the window manager may well have put
# the window somewhere else the second time. Comparing at fixed offsets then
# reports thousands of differing pixels that are really just the desktop
# behind the window -- that happened twice during the Misc migration and looked
# alarming both times. So each shot is aligned on its own window content first,
# by finding the top-left of the tab body colour, and the crop is kept strictly
# inside the window: a crop one row or column too large picks up the background
# and reports a difference that isn't there.
#
# The anchor defaults to functionTabColor rgb(224,210,177), the Misc tab body.
# Override for a window with different chrome:
#
#   FLUID_ANCHOR=724A7C scripts/fluid-compare a.png b.png   # globalLogColor
#
# Migrating a window makes it 30px taller on PC (see doc/fluid-gui.md), so
# anything anchored to the bottom of a tab lands 30px lower afterwards and is
# not comparable at the same offset. Line those parts up by cropping a band
# from each shot at its own depth:
#
#   FLUID_CROP_H=100 FLUID_SKIP_1=445 FLUID_SKIP_2=475 \
#     scripts/fluid-compare before_0.png after_0.png
#
# FLUID_SKIP_n moves side n's crop down from its own anchor.

set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: $(basename "$0") <before.png> <after.png>" >&2
  exit 2
fi

ANCHOR=${FLUID_ANCHOR:-E0D2B1}
# how much of the window to compare, from the anchor; stays inside the frame
CROP_W=${FLUID_CROP_W:-890}
CROP_H=${FLUID_CROP_H:-555}

# Top-left corner of the anchor colour's bounding box. Done by painting every
# other pixel black and asking for the trim box: reading the pixels out as text
# instead means six million lines of awk per screenshot, which takes minutes.
origin() {
  local box
  box=$(convert "$1" -fuzz 0 \
    -fill black +opaque "#$ANCHOR" -fill white -opaque "#$ANCHOR" \
    -format '%@' info: 2>/dev/null)
  # WxH+X+Y, and W=0 when the colour isn't in the image at all
  case $box in
    0x0+*|'') return 1 ;;
  esac
  echo "${box#*+}" | tr '+' ' '
}

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

for side in 1 2; do
  eval "img=\$$side"
  eval "skip=\${FLUID_SKIP_$side:-0}"
  if ! read -r x y <<<"$(origin "$img")"; then
    echo "no anchor colour #$ANCHOR found in $img" >&2
    exit 1
  fi
  echo "  $(basename "$img"): window content at ($x,$y), cropping from +$skip"
  convert "$img" -crop "${CROP_W}x${CROP_H}+$x+$((y + skip))" +repage "$TMP/$side.png"
done

diff=$(compare -metric AE "$TMP/1.png" "$TMP/2.png" null: 2>&1 || true)
echo "differing pixels: $diff"
[ "$diff" = "0" ] || {
  compare "$TMP/1.png" "$TMP/2.png" -compose src \
    -highlight-color white -lowlight-color black "$TMP/mask.png" 2>/dev/null || true
  echo "difference bounding box: $(convert "$TMP/mask.png" -format '%@' info:)"
}
