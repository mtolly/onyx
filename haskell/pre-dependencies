#!/bin/bash
set -e
set -u

# TODO: arch, macos need meson, can probably drop python

case $(uname) in
  Linux )
    echo "linux detected"
    if which pacman > /dev/null; then
      echo "arch detected"
      pacman -Sy --needed rubberband \
        cmake autogen autoconf libtool pkg-config nasm unzip make automake glu pango
      # Manjaro was good with everything but `glu`, which was added for Arch
    elif which apt-get > /dev/null; then
      echo "debian/ubuntu detected"
      apt-get -y update
      apt-get -y install build-essential cmake autogen autoconf libtool \
        libtool-bin pkg-config gettext nasm unzip libx11-dev \
        libxft-dev libpango1.0-dev libgl-dev libxext-dev libglu-dev libjack-dev libpulse-dev \
        libasound2-dev libbz2-dev meson
      # when we use sdl2, maybe add: libudev dbus ibus
    else
      echo "unknown"
      exit 1
    fi
    ;;
  MINGW* )
    echo "windows detected"
    # note, msys2 replaced pkg-config with pkgconf (but still has alias pkg-config).
    # for some reason you need "mingw-w64-x86_64-pkgconf" for haskell to use,
    # but when we used libsndfile that needed "pkgconf" to pick up ogg/vorbis/flac/opus.
    # not sure if other C/C++ libs are the same but keeping it to be safe
    stack exec -- pacman -Sy --needed mingw-w64-x86_64-pkgconf pkgconf \
      wget tar unzip zip man autoconf \
      automake nasm make libtool autogen mingw-w64-x86_64-cmake \
      mingw-w64-x86_64-meson
    ;;
  Darwin )
    echo "macos detected"
    brew install autoconf automake dylibbundler m4 nasm pkg-config rubberband libtool autogen python cmake meson
    ;;
  * )
    echo "unknown"
    exit 1
esac
