#!/bin/bash
BUILD_DIR=$(cd $(dirname "$0") && pwd -P)

# `cabal --extra-lib-dirs=...` applies only to local packages, not to
# source-repository-package deps (e.g. conduit-audio-lame), so those can't find
# C libs in dependencies/root/lib. A `package *` stanza in a project-config
# file applies to every package, so generate cabal.project.local for that.
# Cabal monitors this file by content hash, so rewriting identical content
# does not cause rebuilds.
cat > "$BUILD_DIR"/cabal.project.local <<EOF
-- Generated by cabal-local. Edits will be overwritten.
package *
  extra-lib-dirs: $BUILD_DIR/dependencies/root/lib
  extra-include-dirs: $BUILD_DIR/dependencies/root/include
EOF

env PKG_CONFIG_PATH="$BUILD_DIR"/dependencies/root/lib/pkgconfig \
  LD_LIBRARY_PATH="$BUILD_DIR"/dependencies/root/lib \
  PATH="$BUILD_DIR"/dependencies/root/bin:"$PATH" \
  cabal --project-dir="$BUILD_DIR" "$@"
