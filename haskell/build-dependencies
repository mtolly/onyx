#!/bin/bash
set -e
set -u

cd dependencies
# we can probably just `stack exec make` on all platforms, but this is fine
case $(uname) in
  MINGW* )
    export STACK_YAML=../stack.yaml
    stack exec make
    ;;
  Darwin )
    # oldest macOS to support, keep in sync with stack-local
    export MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-11.0}"
    make
    ;;
  * )
    make
esac
