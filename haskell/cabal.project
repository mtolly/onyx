-- Cabal project file for Onyx
-- Uses Stackage LTS-22.34 constraints via cabal.project.freeze

with-compiler: ghc-9.6.6

-- Local packages (from stack.yaml packages: + extra-deps local folders)
packages:
  packages/onyx-lib
  packages/onyx-lib-game
  packages/onyx-exe-toolkit
  packages/onyx-ffmpeg
  packages/onyx-handle
  packages/onyx-arktool
  packages/onyx-kakasi
  packages/onyx-gamecube-dsp
  packages/onyx-wwise
  packages/onyx-npdata
  packages/onyx-moggcrypt
  packages/onyx-autochart

-- Equivalent to stack's allow-newer: true
allow-newer: all:all

-- Package flags
package fltkhs
  flags: +bundled +opengl

-- Git repository dependencies

source-repository-package
  type: git
  location: https://github.com/mtolly/midi
  tag: 67c595a8f0c3b2fa193c088374de5bf544234ff0

source-repository-package
  type: git
  location: https://github.com/mtolly/conduit-audio
