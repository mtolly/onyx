# data file for the Fltk User Interface Designer (fluid)
version 1.0500
header_name {.h}
code_name {.cxx}
i18n_type 1
i18n_include {"onyx_l10n.h"}
i18n_conditional {}
i18n_gnu_function {onyx_l10n}
i18n_gnu_static_function {onyx_l10n_noop}
comment {The "other tools" window: a tab per utility, plus the shared task tab.

Only the window, the Fl_Tabs and the tab groups themselves live here. Each
tab's contents are still built in Haskell (Onyx.GUI.Misc and taskOutputPage),
which lay themselves out with withRect and so apply the horizontal stretch
on their own. launchMisc therefore runs adaptWindow *before* filling the
tabs, and hands each page the tab's pre-stretch rectangle.

Colours are packed fl_rgb_color values:
  1583242752 = behindTabsColor  rgb(94,94,94)
  3771904256 = functionTabColor rgb(224,210,177)
  3017652992 = taskColor        rgb(179,221,187)} {in_source not_in_header
}

decl {\#include "cache_tab.h"} {public global
}

decl {\#include "file_picker_row.h"} {public global
}

class MiscWindow {open
} {
  Function {MiscWindow()} {open
  } {
    Fl_Window window {
      label {{window-tools}} open
      xywh {100 100 900 600} type Double color 1583242752 resizable visible
    } {
      Fl_Tabs tabs {open
        xywh {0 0 900 600} resizable
      } {
        Fl_Group tabMIDI {
          label {{misc-tab-midi-stuff}} open
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 resizable
        } {}
        Fl_Group tabMOGG {
          label {{misc-tab-mogg-vgs-fsb}}
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
        } {}
        Fl_Group tabLipsync {
          label {{misc-tab-lipsync}} open
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
        } {
          Fl_Group lsMidiFile {
            xywh {0 25 900 50}
            class FilePickerRow
          } {}
          Fl_Round_Button lsLang0 {
            label English
            xywh {10 77 201 35}
          }
          Fl_Round_Button lsLang1 {
            label German
            xywh {211 77 201 35}
          }
          Fl_Round_Button lsLang2 {
            label Spanish
            xywh {412 77 203 35}
          }
          Fl_Counter lsTransition {
            label {Transition (ms)}
            xywh {725 77 165 35} align 4 labelsize 13
          }
          Fl_Button lsMakeVoc {
            xywh {10 124 880 35} color 3017652992
          }
          Fl_Button lsMakeMilo {
            xywh {10 179 287 35} color 3017652992
          }
          Fl_Button lsUpdateMilo {
            xywh {308 179 282 35} color 3017652992
          }
          Fl_Button lsRawLipsync {
            xywh {601 179 289 35} color 3017652992
          }
          Fl_Button lsTracksRB3 {
            xywh {10 234 880 35} color 3017652992
          }
          Fl_Button lsTracksTBRB {
            xywh {10 289 880 35} color 3017652992
          }
          Fl_Box lsFill {
            xywh {10 329 880 266} resizable
          }
        }
        Fl_Group tabDryVox {
          label {{misc-tab-dry-vox}} open
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
        } {
          Fl_Group dvMidiFile {
            xywh {0 25 900 50}
            class FilePickerRow
          } {}
          Fl_Round_Button dvVox0 {
            label {PART VOCALS}
            xywh {10 77 176 35}
          }
          Fl_Round_Button dvVox1 {
            label {HARM1}
            xywh {186 77 176 35}
          }
          Fl_Round_Button dvVox2 {
            label {HARM2}
            xywh {362 77 176 35}
          }
          Fl_Round_Button dvVox3 {
            label {HARM3}
            xywh {538 77 176 35}
          }
          Fl_Round_Button dvVox4 {
            label {(blank)}
            xywh {714 77 176 35}
          }
          Fl_Button dvSine {
            xywh {10 119 880 35} color 3017652992
          }
          Fl_Group dvAudioFile {
            xywh {0 164 900 50}
            class FilePickerRow
          } {}
          Fl_Button dvClipped {
            xywh {10 219 880 35} color 3017652992
          }
          Fl_Box dvFill {
            xywh {10 259 880 336} resizable
          }
        }
        Fl_Group tabMilo {
          label {{misc-tab-milo}} open
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
        } {
          Fl_Button miloExtract {
            xywh {10 30 880 35} color 3017652992
          }
          Fl_Button miloRepack {
            xywh {10 75 880 35} color 3017652992
          }
          Fl_Box miloFill {
            xywh {10 115 880 480} resizable
          }
        }
        Fl_Group tabRB3Cache {
          label {{misc-tab-rb3-cache}} open
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
        } {
          Fl_Group rb3ConFolder {
            xywh {0 25 900 50}
            class FilePickerRow
          } {}
          Fl_Group rb3CacheFile {
            xywh {0 75 900 50}
            class FilePickerRow
          } {}
          Fl_Button rb3Apply {
            xywh {10 130 880 35} color 3017652992
          }
          Fl_Box rb3Fill {
            xywh {10 170 880 425} resizable
          }
        }
        Fl_Group gh3Cache {
          label {{misc-tab-gh3-cache}}
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
          class CacheTab
        } {}
        Fl_Group worCache {
          label {{misc-tab-ghwor-cache}}
          xywh {0 25 900 575} color 3771904256 selection_color 3771904256 hide
          class CacheTab
        } {}
        Fl_Group tabTask {
          label {{tab-task}}
          xywh {0 25 900 575} color 3017652992 selection_color 3017652992 deactivate hide
        } {}
      }
    }
  }
}
