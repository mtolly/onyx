widget_class FileLoadPanel {open
  xywh {0 0 900 525} box FLAT_BOX
} {
  Fl_Box countLabel {
    label {0 files}
    xywh {10 10 880 25}
  }
  Fl_Tree tree {
    xywh {10 45 880 425} resizable
    class HsTree
  }
  Fl_Button addButton {
    label Add
    xywh {10 480 435 35}
  }
  Fl_Button clearButton {
    label Clear
    xywh {455 480 435 35}
  }
  Fl_Box dndOverlay {
    xywh {10 45 880 425}
    class HsDndBox
  }
  code {// FLUID builds the children at their design coordinates, which assume this
// group sits at the origin at its design size. Restate that, then resize
// into the frame we were actually constructed with, so that Fl_Group::resize
// maps the children across. Keep the numbers below in step with the xywh of
// the widget_class itself.
Fl_Widget::resize(0, 0, 900, 525);
resize(X, Y, W, H);} {}
}
