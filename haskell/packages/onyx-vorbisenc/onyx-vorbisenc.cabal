cabal-version:  2.2
name:           onyx-vorbisenc
version:        0.1
build-type:     Simple

library
  exposed-modules:
    Onyx.VorbisEnc
  hs-source-dirs:
    src
  ghc-options: -Wall
  build-depends:
      base
    , bytestring
    , inline-c
    , conduit
    , conduit-audio
    , containers
    , resourcet
    , vector
  default-language: Haskell2010
  pkgconfig-depends: ogg, vorbis, vorbisenc
