cabal-version:  2.2
name:           onyx-fluent
version:        0.1
build-type:     Simple

library
  exposed-modules:

    Onyx.Localization

    Text.Fluent.Syntax
    Text.Fluent.Logic
    Text.Fluent.Locale

  hs-source-dirs:
    src
  ghc-options: -Wall
  build-depends:
      base
    , bytestring
    , text
    , megaparsec
    , unordered-containers
    , scientific
    , filepath
    , directory
    , yaml
    , aeson
  default-language: Haskell2010
